{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techrater-server",
  "main": "cloudflare/src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "TechraterContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TECHRATER",
        "class_name": "TechraterContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TechraterContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
